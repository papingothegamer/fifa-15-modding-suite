<Window x:Class="FIFA15.ScoreboardManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FIFA 15 Scoreboard Manager"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#1a1a2e">

    <Window.Resources>
        <!-- Dark button style -->
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="BorderBrush" Value="#0f3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0f3460"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#e94560"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#e94560"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Accent button style -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#e94560"/>
            <Setter Property="BorderBrush" Value="#e94560"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ListBox item style -->
        <Style x:Key="FileListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#c8c8c8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="#2a2a4a"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#252547"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0f3460"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP TOOLBAR ═══ -->
        <Border Grid.Row="0" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnOpen" Content="📂  Open .big" Style="{StaticResource DarkButton}" Click="BtnOpen_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnSave" Content="💾  Save .big" Style="{StaticResource DarkButton}" Click="BtnSave_Click" IsEnabled="False" Margin="0,0,8,0"/>
                    <Border Width="1" Background="#0f3460" Margin="8,2"/>
                    <Button x:Name="BtnExtractAll" Content="📦  Extract All" Style="{StaticResource DarkButton}" Click="BtnExtractAll_Click" IsEnabled="False" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtArchiveName" DockPanel.Dock="Right" 
                           Foreground="#888" FontSize="12" 
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="No archive loaded"/>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT (TWO PANES) ═══ -->
        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: File List -->
            <Border Grid.Column="0" Background="#1a1a2e" BorderBrush="#0f3460" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="12,8" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                        <TextBlock Text="Archive Contents" Foreground="#aaa" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <ListBox x:Name="LstFiles"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource FileListItem}"
                             SelectionChanged="LstFiles_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding TypeIcon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="12"/>
                                        <TextBlock Text="{Binding SizeInfo}" FontSize="10" Foreground="#666"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" Width="3" Background="#0f3460" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- RIGHT: Preview Panel -->
            <Border Grid.Column="2" Background="#1e1e3a">
                <DockPanel>
                    <!-- Action bar -->
                    <Border DockPanel.Dock="Top" Background="#16213e" Padding="12,8" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock x:Name="TxtPreviewTitle" Text="Select a file to preview" Foreground="#aaa" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <Button x:Name="BtnImport" Content="⬆  Import" Style="{StaticResource AccentButton}" Click="BtnImport_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                <Button x:Name="BtnExport" Content="⬇  Export" Style="{StaticResource DarkButton}" Click="BtnExport_Click" IsEnabled="False"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Preview area -->
                    <Grid x:Name="PreviewArea">
                        <!-- Image preview (shown for DDS files) -->
                        <Border x:Name="ImagePreviewPanel" Visibility="Collapsed" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#12122a" CornerRadius="6" Padding="8" BorderBrush="#2a2a4a" BorderThickness="1">
                                    <Image x:Name="ImgPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <TextBlock x:Name="TxtImageInfo" Grid.Row="1" Foreground="#777" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Hex preview (shown for non-DDS files) -->
                        <Border x:Name="HexPreviewPanel" Visibility="Collapsed" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Hex Data (read-only)" Foreground="#666" FontSize="11" Margin="0,0,0,6"/>
                                <Border Grid.Row="1" Background="#12122a" CornerRadius="6" Padding="10" BorderBrush="#2a2a4a" BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="TxtHexView" FontFamily="Consolas" FontSize="12" Foreground="#8be9fd" TextWrapping="NoWrap"/>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <Border x:Name="EmptyPreviewPanel" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Open a .big archive and select a file" Foreground="#555" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="to preview its contents here." Foreground="#444" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══ STATUS BAR ═══ -->
        <Border Grid.Row="2" Background="#16213e" BorderBrush="#0f3460" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready" Foreground="#888" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtFileCount" Text="" Foreground="#555" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
