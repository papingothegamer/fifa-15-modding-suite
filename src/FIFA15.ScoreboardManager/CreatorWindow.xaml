<Window x:Class="FIFA15.ScoreboardManager.CreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scoreboard Creator" Height="700" Width="1000"
        Background="#1a1a2e" Foreground="#e0e0e0" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313155"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DropZoneStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4a4a75"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#252545"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="AllowDrop" Value="True"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Scoreboard Creator" Style="{StaticResource HeaderStyle}"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,20">
            <TextBlock Text="Select Base Template: " VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbTemplate" Width="200" Margin="10,0,0,0" SelectedIndex="0" Padding="5">
                <ComboBoxItem Content="Horizontal Template"/>
            </ComboBox>
        </StackPanel>

        <!-- Drop Zones for Horizontal Template -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <WrapPanel>
                <!-- Main Texture Drop Zone -->
                <Border Style="{StaticResource DropZoneStyle}" Width="300" Height="200" Margin="10" Drop="DropZone_Drop" Tag="21">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Main Scoreboard Background" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Required: 512 x 128" Foreground="#aaa" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag PNG Here" Foreground="#8be9fd" HorizontalAlignment="Center"/>
                        <Image x:Name="ImgMainTexture" Margin="0,10,0,0" MaxHeight="80" MaxWidth="280"/>
                    </StackPanel>
                </Border>

                <!-- Team Color 1 -->
                <Border Style="{StaticResource DropZoneStyle}" Width="300" Height="200" Margin="10" Drop="DropZone_Drop" Tag="50">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Team Color Block 1" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Required: 16 x 16 (White Base)" Foreground="#aaa" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag PNG Here" Foreground="#8be9fd" HorizontalAlignment="Center"/>
                        <Image x:Name="ImgTeamColor1" Margin="0,10,0,0" MaxHeight="80" MaxWidth="280"/>
                    </StackPanel>
                </Border>

                <!-- Team Color 2 -->
                <Border Style="{StaticResource DropZoneStyle}" Width="300" Height="200" Margin="10" Drop="DropZone_Drop" Tag="53">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Team Color Block 2" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Required: 16 x 16 (White Base)" Foreground="#aaa" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag PNG Here" Foreground="#8be9fd" HorizontalAlignment="Center"/>
                        <Image x:Name="ImgTeamColor2" Margin="0,10,0,0" MaxHeight="80" MaxWidth="280"/>
                    </StackPanel>
                </Border>
                
                <!-- Stoppage Time -->
                <Border Style="{StaticResource DropZoneStyle}" Width="300" Height="200" Margin="10" Drop="DropZone_Drop" Tag="5">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Stoppage Time Background" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Required: 128 x 64" Foreground="#aaa" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drag PNG Here" Foreground="#8be9fd" HorizontalAlignment="Center"/>
                        <Image x:Name="ImgStoppageTime" Margin="0,10,0,0" MaxHeight="80" MaxWidth="280"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </ScrollViewer>

        <!-- Generation Controls -->
        <Border Grid.Row="3" Background="#22223b" Padding="15" Margin="0,20,0,0" CornerRadius="5">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Click="BtnClose_Click"/>
                <Button Content="Generate Scoreboard .BIG" Background="#e43f5a" Click="BtnGenerate_Click" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
