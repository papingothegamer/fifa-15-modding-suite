<Window x:Class="FIFA15.ScoreboardManager.PackExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pack Explorer &amp; Texture Exporter" Height="700" Width="1000"
        Background="#1a1a2e" Foreground="#e0e0e0" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#16213e"/>
            <Setter Property="Foreground" Value="#e0e0e0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#0f3460"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0f3460"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" BasedOn="{StaticResource ModernButton}" TargetType="Button">
            <Setter Property="Background" Value="#e43f5a"/>
            <Setter Property="BorderBrush" Value="#e43f5a"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#ff5e78"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#16213e" Padding="15" BorderBrush="#0f3460" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Browse Source Pack Folder" Style="{StaticResource ModernButton}" Click="BtnBrowseSource_Click" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="TxtSourcePath" Text="No folder selected..." VerticalAlignment="Center" Foreground="#888" TextTrimming="CharacterEllipsis" Margin="0,0,20,0"/>

                <Button Grid.Column="2" Content="Browse Output Folder" Style="{StaticResource ModernButton}" Click="BtnBrowseOutput_Click" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="3" x:Name="TxtOutputPath" Text="No output selected..." VerticalAlignment="Center" Foreground="#888" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- Gallery Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15">
            <ItemsControl x:Name="GalleryItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#16213e" BorderBrush="#0f3460" BorderThickness="1" CornerRadius="6" Margin="10" Width="280">
                            <StackPanel Margin="10">
                                <!-- Image Preview -->
                                <Border Background="#0f3460" Height="140" CornerRadius="4" Margin="0,0,0,10">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Filename -->
                                <TextBlock Text="{Binding FileName}" Foreground="#e0e0e0" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                                <!-- Mapping Dropdown -->
                                <TextBlock Text="Target FIFA 15 ID:" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding TargetOptions}" SelectedValuePath="Key" DisplayMemberPath="Value" SelectedValue="{Binding TargetId, Mode=TwoWay}" Background="#1a1a2e" Foreground="#333"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#16213e" Padding="15" BorderBrush="#0f3460" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="TxtStatus" Text="Ready." VerticalAlignment="Center" Foreground="#888"/>
                <Button Content="📤 Export Main Textures" Style="{StaticResource AccentButton}" DockPanel.Dock="Right" HorizontalAlignment="Right" Click="BtnExport_Click" Padding="20,8"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
