<Window x:Class="FIFA15.ScoreboardManager.ZeroCoordinatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zero Out Coordinates" Height="250" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0a0a1a" Foreground="#e0e0e0">
    <Window.Resources>
        <!-- Re-use generic styles from App.xaml -->
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="IMAGE HIDDEN SUCCESSFULLY" Foreground="#4ade80" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#bbb" Margin="0,0,0,15" TextAlignment="Center">
            Do you want to push this element off-screen to prevent layer clashing? Enter its X and Y Hex Offsets if known. Leave blank to skip.
        </TextBlock>

        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="X Offset (Hex):" VerticalAlignment="Center" Margin="0,0,10,10"/>
            <TextBox x:Name="TxtOffsetX" Grid.Column="1" Margin="0,0,0,10" Padding="4" Background="#16213e" Foreground="White" BorderBrush="#2a2a4a" />

            <TextBlock Grid.Row="1" Text="Y Offset (Hex):" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtOffsetY" Grid.Row="1" Grid.Column="1" Padding="4" Background="#16213e" Foreground="White" BorderBrush="#2a2a4a" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Skip" Click="BtnSkip_Click" Width="80" Margin="0,0,10,0" Background="#16213e" Foreground="White" BorderBrush="#2a2a4a"/>
            <Button Content="Apply &amp; Zero" Click="BtnApply_Click" Width="120" Background="#3b82f6" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
